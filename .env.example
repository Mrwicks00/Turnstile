# Node RPC connection
TURNSTILE_RPC_URL=http://127.0.0.1:8232
# TURNSTILE_RPC_AUTH_MODE: cookie (default, our own zebrad/zcashd node) | apikey (hosted
# gateway, e.g. Tatum, via TURNSTILE_RPC_API_KEY) | none (a hosted free tier needing no auth)
TURNSTILE_RPC_AUTH_MODE=cookie
TURNSTILE_RPC_COOKIE_PATH=~/.cache/zebra/.cookie
#TURNSTILE_RPC_API_KEY=

# Example hosted-provider config (Tatum's public testnet gateway - no z_gettreestate support,
# fine for Phase 1/Mode B, not sufficient for Phase 2's anchor-fetching):
#TURNSTILE_RPC_URL=https://zcash-testnet.gateway.tatum.io
#TURNSTILE_RPC_AUTH_MODE=none

# Network selection (testnet | mainnet) - selects the activation height below
TURNSTILE_NETWORK=testnet
TURNSTILE_ACTIVATION_HEIGHT_TESTNET=4134000
TURNSTILE_ACTIVATION_HEIGHT_MAINNET=3428143

# Test-only overrides - unset for production Mode B runs
#TURNSTILE_START_HEIGHT_OVERRIDE=12000
#TURNSTILE_STOP_HEIGHT_OVERRIDE=12400

# Indexer behavior
TURNSTILE_CONCURRENCY=4
TURNSTILE_DB_PATH=./data/turnstile.sqlite
TURNSTILE_RUN_MODE=follow
TURNSTILE_POLL_INTERVAL_MS=5000
TURNSTILE_MAX_REORG_DEPTH=100

# RPC client tuning
TURNSTILE_RPC_TIMEOUT_MS=15000
TURNSTILE_RPC_MAX_RETRIES=5
TURNSTILE_RPC_RETRY_BASE_MS=250
TURNSTILE_RPC_RETRY_MAX_MS=5000
